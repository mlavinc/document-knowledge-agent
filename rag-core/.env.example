PROJECT_NAME=Knowledge RAG Agent
VERSION=1.0.0
API_PREFIX=/api/v1

# --- Selección de proveedor (independiente por dominio) ---
# local: LLM_PROVIDER=ollama, EMBEDDING_PROVIDER=ollama, VECTOR_DB_PROVIDER=chroma, STORAGE_PROVIDER=filesystem
# demo:  LLM_PROVIDER=openai, LLM_MODEL=gpt-4.1-mini  (+ OPENAI_API_KEY)
# AWS:   LLM_PROVIDER=bedrock, EMBEDDING_PROVIDER=bedrock, VECTOR_DB_PROVIDER=pgvector, STORAGE_PROVIDER=s3
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
VECTOR_DB_PROVIDER=chroma
STORAGE_PROVIDER=filesystem

# --- LLM (unificado) ---
# ollama local:  LLM_MODEL=qwen2.5:3b
# openai demo:   LLM_MODEL=gpt-4.1-mini
LLM_MODEL=qwen2.5:3b
OPENAI_API_KEY=

# --- Local (Ollama + ChromaDB) ---
OLLAMA_BASE_URL=http://localhost:11434
# Legacy alias retained for compatibility; prefer LLM_MODEL above.
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=documents

RAG_TOP_K=8
RAG_MIN_SCORE=0.35

# --- AWS (producción) ---
AWS_REGION=sa-east-1
BEDROCK_LLM_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE_NAME=ragagent
AURORA_TABLE_NAME=document_chunks

S3_DOCUMENTS_BUCKET=
