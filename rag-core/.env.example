PROJECT_NAME=Knowledge RAG Agent
VERSION=1.0.0
API_PREFIX=/api/v1

# --- Desarrollo local ---
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# VECTOR_DB_PROVIDER=chroma
# STORAGE_PROVIDER=filesystem
#
# --- Producción / demo ---
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# VECTOR_DB_PROVIDER=pgvector
# STORAGE_PROVIDER=s3
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY_SSM_PARAMETER=/rag-agent/openai-api-key
# (no pongas la API key en Terraform; usa SSM SecureString)

LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
VECTOR_DB_PROVIDER=chroma
STORAGE_PROVIDER=filesystem

LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OPENAI_API_KEY=
OPENAI_API_KEY_SSM_PARAMETER=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=documents

RAG_TOP_K=8
RAG_MIN_SCORE=0.55

AWS_REGION=sa-east-1

AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE_NAME=ragagent
AURORA_TABLE_NAME=document_chunks
AURORA_PORTFOLIO_TABLE_NAME=document_chunks_portfolio
CHROMA_PORTFOLIO_COLLECTION=portfolio_documents

S3_DOCUMENTS_BUCKET=
