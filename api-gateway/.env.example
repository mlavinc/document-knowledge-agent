NODE_ENV=development
PORT=3000
# En Docker Compose usar el nombre del servicio: http://rag-core:8000
# Fuera de Docker (npm run dev en el host): http://localhost:8000
RAG_CORE_URL=http://rag-core:8000
# One origin, comma-separated list (demo + portfolio), or *
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- AWS (producción) ---
AWS_REGION=sa-east-1
# none en desarrollo local; iam cuando rag-core corre en una Lambda
# Function URL con autenticación IAM (las peticiones se firman con SigV4
# usando las credenciales del rol de ejecución de esta Lambda).
RAG_CORE_AUTH_MODE=none
