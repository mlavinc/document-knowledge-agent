NODE_ENV=development
PORT=3000
RAG_CORE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173

# --- AWS (producción) ---
AWS_REGION=sa-east-1
# none en desarrollo local; iam cuando rag-core corre en una Lambda
# Function URL con autenticación IAM (las peticiones se firman con SigV4
# usando las credenciales del rol de ejecución de esta Lambda).
RAG_CORE_AUTH_MODE=none
